[Unit]
Description=Daemon Vigil (Telegram <-> Claude agent)

[Service]
WorkingDirectory=%h/daemonVigil
Environment=PATH=%h/daemonVigil/venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/daemonVigil/venv/bin/python main.py --silent
Restart=always
RestartSec=10
# main.py already writes daemon_vigil.log itself; console output (incl. crash
# tracebacks) goes to the journal: journalctl --user -u daemon-vigil

[Install]
WantedBy=default.target

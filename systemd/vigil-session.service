[Unit]
Description=Vigil: persistent Claude Code session in tmux (Telegram channel + vigil-bridge)

[Service]
Type=forking
WorkingDirectory=%h/vigil
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/tmux new-session -d -s vigil -c %h/vigil %h/daemonVigil/scripts/run-session.sh
ExecStop=/usr/bin/tmux kill-session -t vigil
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
